{
  "name": "arknights-arc-income-calculator",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "build:desktop": "npm run build && dotnet publish desktop/ArcIncCalc.Desktop.csproj -c Release -r win-x64 --self-contained true -o release/ArcIncCalc",
    "pack": "powershell -ExecutionPolicy Bypass -File scripts/pack-release.ps1",
    "sync:tools": "powershell -ExecutionPolicy Bypass -File scripts/sync-tools.ps1",
    "audit:data": "node scripts/audit-riic-data.mjs \"C:/Users/Panda-Panta/Downloads/Compressed/ArknightsGameData-master/zh_CN/gamedata/excel\"",
    "test": "vitest run",
    "typecheck": "vue-tsc -b",
    "surrogate:generate": "tsx scripts/surrogate/generate_dataset.ts",
    "surrogate:train": "python scripts/surrogate/train.py",
    "surrogate:export": "python scripts/surrogate/export.py",
    "surrogate:pipeline": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/surrogate/run_pipeline.ps1"
  },
  "dependencies": {
    "html-to-image": "^1.11.13",
    "jsqr": "^1.4.0",
    "naive-ui": "^2.45.3",
    "onnxruntime-web": "^1.30.0",
    "pako": "^3.0.1",
    "pinia": "4.0.3",
    "pinyin-pro": "^3.29.3",
    "qrcode": "^1.5.4",
    "vue": "^3.5.22",
    "vue-slicksort": "^2.0.5"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "@types/qrcode": "^1.5.6",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vue/test-utils": "^2.5.0",
    "@vue/tsconfig": "^0.8.1",
    "jpeg-js": "^0.4.4",
    "jsdom": "^30.0.1",
    "sass": "^1.104.0",
    "typescript": "~5.9.3",
    "vite": "^7.1.12",
    "vitest": "^3.2.4",
    "vue-tsc": "^3.1.3"
  },
  "packageManager": "pnpm@11.19.0"
}
